# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# Transaction pooler (:6543). Used by the app at runtime.
DATABASE_URL=
# Direct connection (:5432). Used by drizzle-kit for migrations only.
DIRECT_URL=

# ---------------------------------------------------------------------------
# File storage — Vercel Blob
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# anthropic | openai-compatible | fake
# Falls back to `fake` automatically when the selected provider has no API key,
# so the demo always runs.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Free alternatives (set LLM_PROVIDER=openai-compatible) ---
# Groq        BASE_URL=https://api.groq.com/openai/v1
#             MODEL=llama-3.3-70b-versatile
# Gemini      BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#             MODEL=gemini-2.0-flash
# OpenRouter  BASE_URL=https://openrouter.ai/api/v1
#             MODEL=<any model with a :free suffix>
# Ollama      BASE_URL=http://localhost:11434/v1
#             MODEL=llama3.1            (API key can be any non-empty string)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
